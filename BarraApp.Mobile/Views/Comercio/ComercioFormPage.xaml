<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BarraApp.Mobile.ViewModels.Comercio"
             xmlns:controls="clr-namespace:BarraApp.Mobile.Controls"
             x:Class="BarraApp.Mobile.Views.Comercio.ComercioFormPage"
             x:DataType="vm:ComercioFormViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource AppBg}">

    <ScrollView>
        <VerticalStackLayout Padding="20,25,20,40"
                             Spacing="16"
                             MaximumWidthRequest="520"
                             HorizontalOptions="Center">

            <!-- Barra superior -->
            <Grid ColumnDefinitions="Auto,*">
                <Border BackgroundColor="{StaticResource AppCard}"
                        Stroke="{StaticResource AppBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        HeightRequest="40"
                        WidthRequest="40">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding VolverCommand}" />
                    </Border.GestureRecognizers>
                    <Path Data="M15 19l-7-7 7-7"
                          Stroke="{StaticResource AppText}"
                          StrokeThickness="2"
                          StrokeLineCap="Round"
                          WidthRequest="18"
                          HeightRequest="18"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Border>

                <Label Grid.Column="1"
                       Text="{Binding Titulo}"
                       FontSize="20"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       Margin="15,0,0,0" />
            </Grid>

            <controls:FloatingEntry Placeholder="Nombre del comercio *"
                                    Text="{Binding Nombre}"
                                    IsEnabled="{Binding PuedeInteractuar}" />

            <controls:FloatingEntry Placeholder="Cadena (Ej. Walmart, Pali)"
                                    Text="{Binding Cadena}"
                                    IsEnabled="{Binding PuedeInteractuar}" />

            <controls:FloatingEntry Placeholder="Dirección *"
                                    Text="{Binding Direccion}"
                                    IsEnabled="{Binding PuedeInteractuar}" />

            <controls:FloatingEntry Placeholder="Teléfono"
                                    Keyboard="Telephone"
                                    Text="{Binding Telefono}"
                                    IsEnabled="{Binding PuedeInteractuar}" />

            <controls:FloatingEntry Placeholder="Horario (Ej. Lun-Sáb 8am-8pm)"
                                    Text="{Binding Horario}"
                                    IsEnabled="{Binding PuedeInteractuar}" />

            <!-- Ubicacion -->
            <Border BackgroundColor="{StaticResource AppCard}"
                    Stroke="{StaticResource AppBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="UBICACIÓN *" TextColor="{StaticResource Gray400}" FontSize="12" FontAttributes="Bold" />

                    <Label Text="Se usa para mostrar el comercio a quienes lo tengan cerca. Lo mejor es registrarlo estando dentro del local."
                           TextColor="{StaticResource AppSubtext}"
                           FontSize="12"
                           LineBreakMode="WordWrap" />

                    <!-- Botón limpio sin emoji -->
                    <Button Text="Usar mi ubicación actual"
                            Command="{Binding UsarMiUbicacionCommand}"
                            IsEnabled="{Binding PuedeInteractuar}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource AppYellow}"
                            BorderColor="{StaticResource AppYellow}"
                            BorderWidth="1.5"
                            HeightRequest="38"
                            CornerRadius="10" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <controls:FloatingEntry Placeholder="Latitud"
                                                Text="{Binding LatitudTexto}"
                                                IsEnabled="{Binding PuedeInteractuar}" />
                        <controls:FloatingEntry Grid.Column="1"
                                                Placeholder="Longitud"
                                                Text="{Binding LongitudTexto}"
                                                IsEnabled="{Binding PuedeInteractuar}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Alerta más fina y estilizada -->
            <Border BackgroundColor="#2A1212"
                    Stroke="#EF4444"
                    StrokeThickness="0.8"
                    StrokeShape="RoundRectangle 12"
                    Padding="12,10"
                    IsVisible="{Binding HasError}">
                <Label Text="{Binding MensajeError}" TextColor="#EF4444" FontSize="12" LineBreakMode="WordWrap" />
            </Border>

            <Button Text="{Binding TextoGuardar}"
                    Command="{Binding GuardarCommand}"
                    IsEnabled="{Binding PuedeInteractuar}"
                    Margin="0,6,0,0">
                <Button.Shadow>
                    <Shadow Brush="{StaticResource AppYellow}" Offset="0,10" Radius="30" Opacity="0.2" />
                </Button.Shadow>
            </Button>

            <ActivityIndicator IsRunning="{Binding EstaOcupado}"
                               IsVisible="{Binding EstaOcupado}"
                               HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>