<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BarraApp.Mobile.ViewModels.ListaCompra"
             xmlns:core="clr-namespace:Core.Entidades.Enti_Clases;assembly=Core"
             x:Class="BarraApp.Mobile.Views.ListaCompra.ListaDetallePage"
             x:DataType="vm:ListaDetalleViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource AppBg}">

    <ScrollView>
        <VerticalStackLayout Padding="20,25,20,40"
                             Spacing="16"
                             MaximumWidthRequest="520"
                             HorizontalOptions="Center">

            <!-- Barra superior -->
            <Grid ColumnDefinitions="Auto, *">
                <Border BackgroundColor="{StaticResource AppCard}"
                        Stroke="{StaticResource AppBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        HeightRequest="40"
                        WidthRequest="40">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding VolverCommand}" />
                    </Border.GestureRecognizers>
                    <Path Data="M15 19l-7-7 7-7"
                          Stroke="{StaticResource AppText}"
                          StrokeThickness="2"
                          StrokeLineCap="Round"
                          WidthRequest="18"
                          HeightRequest="18"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Border>

                <Label Grid.Column="1"
                       Text="{Binding NombreLista}"
                       FontSize="20"
                       FontAttributes="Bold"
                       LineBreakMode="TailTruncation"
                       VerticalOptions="Center"
                       Margin="15,0,0,0" />
            </Grid>

            <ActivityIndicator IsRunning="{Binding EstaOcupado}"
                               IsVisible="{Binding EstaOcupado}"
                               HeightRequest="36"
                               HorizontalOptions="Center" />

            <Border BackgroundColor="#2A1212"
                    Stroke="#EF4444"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="14"
                    IsVisible="{Binding HasError}">
                <Label Text="{Binding MensajeError}"
                       TextColor="#EF4444"
                       FontSize="13"
                       LineBreakMode="WordWrap" />
            </Border>

            <Button Text="{Binding TextoBotonBuscador}"
                    Command="{Binding AlternarBuscadorCommand}"
                    IsEnabled="{Binding PuedeInteractuar}" />

            <!-- Buscador de productos -->
            <Border BackgroundColor="{StaticResource AppCard}"
                    Stroke="{StaticResource AppBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="14"
                    IsVisible="{Binding BuscadorVisible}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Buscar producto" FontAttributes="Bold" FontSize="16" />

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                        <Border Style="{StaticResource InputBorderStyle}" HeightRequest="48" Padding="12,0">
                            <Entry Placeholder="Nombre o marca..."
                                   Text="{Binding TextoBusqueda}"
                                   ReturnCommand="{Binding BuscarCommand}" />
                        </Border>
                        <Button Grid.Column="1"
                                Text="Buscar"
                                HeightRequest="48"
                                MinimumHeightRequest="48"
                                CornerRadius="14"
                                Padding="18,0"
                                Command="{Binding BuscarCommand}" />
                    </Grid>

                    <ActivityIndicator IsRunning="{Binding Buscando}"
                                       IsVisible="{Binding Buscando}"
                                       HorizontalOptions="Center" />

                    <Label Text="No se encontraron productos con ese nombre."
                           TextColor="{StaticResource AppSubtext}"
                           IsVisible="{Binding SinResultados}"
                           HorizontalOptions="Center" />

                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Resultados}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="core:Producto">
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding nombre}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding marca}" TextColor="{StaticResource AppSubtext}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1"
                                            Text="Agregar"
                                            FontSize="13"
                                            HeightRequest="38"
                                            MinimumHeightRequest="38"
                                            CornerRadius="12"
                                            Padding="14,0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListaDetalleViewModel}}, Path=AgregarProductoCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Lista vacia -->
            <VerticalStackLayout Spacing="8" Margin="0,30,0,0" IsVisible="{Binding ListaVacia}">
                <Label Text="🧺" FontSize="42" HorizontalOptions="Center" />
                <Label Text="La lista está vacía"
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />
                <Label Text="Usa «Agregar producto» para empezar."
                       TextColor="{StaticResource AppSubtext}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Productos de la lista -->
            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Items}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="core:ItemLista">
                        <Border BackgroundColor="{StaticResource AppCard}"
                                Stroke="{StaticResource AppBorder}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                Padding="12,10">
                            <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="10">

                                <!-- Marcar como comprado -->
                                <Label Text="○"
                                       FontSize="26"
                                       TextColor="{StaticResource AppSubtext}"
                                       VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding completado}" Value="True">
                                            <Setter Property="Text" Value="✓" />
                                            <Setter Property="TextColor" Value="{StaticResource AppYellow}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListaDetalleViewModel}}, Path=AlternarCompletadoCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>

                                <Label Grid.Column="1"
                                       Text="{Binding nombreProducto}"
                                       FontSize="16"
                                       VerticalOptions="Center"
                                       LineBreakMode="TailTruncation">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding completado}" Value="True">
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                            <Setter Property="TextColor" Value="{StaticResource AppSubtext}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <!-- Cantidad -->
                                <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                    <Button Text="−"
                                            FontSize="18"
                                            WidthRequest="32"
                                            HeightRequest="32"
                                            MinimumHeightRequest="32"
                                            Padding="0"
                                            CornerRadius="16"
                                            BackgroundColor="{StaticResource Gray600}"
                                            TextColor="{StaticResource AppText}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListaDetalleViewModel}}, Path=DecrementarCommand}"
                                            CommandParameter="{Binding .}" />
                                    <Label Text="{Binding cantidad, StringFormat='{0:0.##}'}"
                                           FontAttributes="Bold"
                                           MinimumWidthRequest="22"
                                           HorizontalTextAlignment="Center"
                                           VerticalOptions="Center" />
                                    <Button Text="+"
                                            FontSize="18"
                                            WidthRequest="32"
                                            HeightRequest="32"
                                            MinimumHeightRequest="32"
                                            Padding="0"
                                            CornerRadius="16"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListaDetalleViewModel}}, Path=IncrementarCommand}"
                                            CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>

                                <Button Grid.Column="3"
                                        Text="🗑️"
                                        FontSize="16"
                                        BackgroundColor="Transparent"
                                        WidthRequest="38"
                                        HeightRequest="38"
                                        MinimumHeightRequest="38"
                                        Padding="0"
                                        VerticalOptions="Center"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListaDetalleViewModel}}, Path=EliminarItemCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
