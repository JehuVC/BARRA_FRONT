<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:BarraApp.Mobile.ViewModels.Usuario"
             xmlns:controls="clr-namespace:BarraApp.Mobile.Controls"
             x:Class="BarraApp.Mobile.Views.Usuario.RecuperarPage"
             x:DataType="viewmodels:RecuperarViewModel"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="30,50,30,30" Spacing="20" MaximumWidthRequest="520" HorizontalOptions="Center">

            <Label Text="Recuperar contraseña"
                   FontSize="28" FontAttributes="Bold" TextColor="{StaticResource AppText}"
                   HorizontalOptions="Center" Margin="0,0,0,5"/>

            <Label Text="Escribe el correo de tu cuenta y te enviaremos un código para crear una contraseña nueva."
                   TextColor="{StaticResource AppSubtext}" FontSize="14"
                   HorizontalTextAlignment="Center" HorizontalOptions="Center"/>

            <controls:FloatingEntry Placeholder="Correo electrónico"
                                    Keyboard="Email"
                                    Text="{Binding Correo}"
                                    IsEnabled="{Binding PuedeEnviar}" />

            <Label Text="{Binding MensajeError}"
                   TextColor="#EF4444"
                   IsVisible="{Binding HasError}"
                   HorizontalOptions="Center"
                   FontSize="13"
                   LineBreakMode="WordWrap"
                   HorizontalTextAlignment="Center"/>

            <Button Text="Enviar código"
                    Command="{Binding EnviarCodigoCommand}"
                    IsEnabled="{Binding PuedeEnviar}"
                    Margin="0,10,0,0">
                <Button.Shadow>
                    <Shadow Brush="{StaticResource AppYellow}" Offset="0,10" Radius="30" Opacity="0.2"/>
                </Button.Shadow>
            </Button>

            <ActivityIndicator IsRunning="{Binding EstaOcupado}"
                               IsVisible="{Binding EstaOcupado}"
                               Color="{StaticResource AppYellow}"
                               HorizontalOptions="Center" />

            <Label Text="Volver a iniciar sesión"
                   TextColor="{StaticResource AppSubtext}"
                   HorizontalOptions="Center"
                   TextDecorations="Underline"
                   Margin="0,10,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding VolverCommand}"/>
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
