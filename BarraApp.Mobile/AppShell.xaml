<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BarraApp.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:usuario="clr-namespace:BarraApp.Mobile.Views.Usuario"
    xmlns:dashboard="clr-namespace:BarraApp.Mobile.Views.Dashboard"
    Title="BarraApp.Mobile"
    FlyoutBehavior="Disabled"
    Shell.TabBarIsVisible="False">

    <ShellContent
        Title="Ingresar"
        ContentTemplate="{DataTemplate usuario:LoginPage}"
        Route="LoginPage" />

    <ShellContent
        Title="Inicio"
        ContentTemplate="{DataTemplate dashboard:DashboardPage}"
        Route="DashboardPage" />

</Shell>
